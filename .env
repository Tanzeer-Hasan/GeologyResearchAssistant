# Copy this file to .env and fill in your values

# Core application settings
APP_NAME=ScienceAndEngineeringResearchAssistant
APP_ENV=development
APP_PORT=8000

# LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4o-mini

# Institutional access and metadata providers
SCOPUS_API_KEY=
SCOPUS_INST_TOKEN=
INSTITUTION_NAME=
INSTITUTION_PROXY_URL=
INSTITUTION_SSO_ENABLED=false

# Search integrations
GOOGLE_SCHOLAR_ENABLED=false
CROSSREF_EMAIL=your-email@example.com
OPENALEX_EMAIL=your-email@example.com

# Citations and storage
ZOTERO_API_KEY=
ZOTERO_LIBRARY_ID=

# Database
DATABASE_URL=sqlite:///./research.db

# Logging and security
SECRET_KEY=change-me
